# Copy to .env for local use. On Vercel set these in Project → Settings → Environment Variables.
# Never commit real values: .env is git-ignored.

# --- Admin login for /admin (required for the admin dashboard) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Signs login sessions. Use a long random string (e.g. `openssl rand -hex 32`). ---
SESSION_SECRET=""

# --- Database (required on Vercel, optional locally) ---
# Postgres connection string, e.g. from Neon (Vercel → Storage → Neon adds it automatically).
# Without it the server stores data in ./data/dukaan-saathi.json (on Vercel that file is temporary).
DATABASE_URL=""

# --- AI (Gemini). Used only by the server, never sent to the browser. ---
# Without a key: typed entries still work (rule-based parser); voice notes and shelf photos are not analysed.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.8-flash"
# Prices in USD per million tokens, for the cost estimate in the admin dashboard:
# GEMINI_INPUT_USD_PER_MTOK=""
# GEMINI_OUTPUT_USD_PER_MTOK=""

# --- Optional ---
# Set to "false" so only the admin can create vendor accounts.
# ALLOW_SIGNUP="true"
# PORT=3000

# --- Leads CRM: automatic WhatsApp sending (optional) ---
# Without these, scheduled messages show up in the app at their time and the owner taps send in WhatsApp.
# With them, the server sends through the WhatsApp Cloud API (Meta Business account needed).
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_GRAPH_VERSION="v21.0"
# Protects GET /api/cron/send-due (call it every minute with "Authorization: Bearer <CRON_SECRET>").
# Not needed with `npm start` / `npm run dev`: the Node server checks every minute by itself.
# CRON_SECRET=""
